# Postgres (Neon).
# Locally: both can be the direct connection string.
# On Vercel: DATABASE_URL = pooled (host contains -pooler), DATABASE_URL_UNPOOLED = direct.
DATABASE_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="${DATABASE_URL}"

# gemini | mock  (mock needs no key and is deterministic)
LLM_PROVIDER="mock"
GEMINI_API_KEY=""
LLM_MODEL="gemini-2.5-flash"

LOG_LEVEL="info"

# Analysis rate limits (protect the LLM quota on the public demo)
ANALYZE_COOLDOWN_SECONDS="30"
ANALYZE_MAX_PER_HOUR="30"
